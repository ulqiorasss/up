<Window x:Class="lera_dem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lera_dem"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Border Width="250" Height="300" VerticalAlignment="Center" BorderBrush="Black" BorderThickness="1" CornerRadius="5" Background="#FFCF48  ">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Width="130" Height="30" Text="АВТОРИЗАЦИЯ" FontSize="16" Foreground="#FF0E0D0D" FontWeight="Bold" HorizontalAlignment="Center"/>
                <Grid Margin="0,0,0,10">
                    <TextBox x:Name="Login" Height="30" Width="180" VerticalContentAlignment="Center" Padding="5,0,0,0"/>
                    <TextBlock IsHitTestVisible="False" Text="Логин" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DarkGray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=Login}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <PasswordBox x:Name="FamilyInputBox" Height="30" Width="180" VerticalContentAlignment="Center" Padding="5,0,0,0"/>
                    <TextBlock IsHitTestVisible="False" Text="Пароль" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DarkGray">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Password, ElementName=FamilyInputBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Content="Вход" Click="Button_Click_Catalog" Height="30" Width="180" Margin="0,0,0,5"/>
                <Button Content="Войти как гость" Click="Button_Click_Guest" Height="30" Width="180"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
